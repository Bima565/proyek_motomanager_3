# MotoManage Environment Variables Example
# Salin file ini menjadi .env dan masukkan kredensial asli

# Brevo REST API (Web & Android, 300 email/hari gratis tanpa domain)
BREVO_API_KEY=_api_key_brevo
BREVO_SENDER_EMAIL=_email@gmail.com

# Firebase Client API Keys
FIREBASE_WEB_API_KEY=_web_api_key
FIREBASE_ANDROID_API_KEY=_android_api_key_
