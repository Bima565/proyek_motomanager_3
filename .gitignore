# =====================================================================
# MotoManage - Git Ignore Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Operating System (Windows & macOS & Linux)
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# 2. Node.js (Dependencies & Scripts)
# ---------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# 3. Firebase, Secrets, Keystores & Credentials (CRITICAL)
# ---------------------------------------------------------------------
*firebase-adminsdk*.json
*service-account*.json
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
*.env
.env*
*.key
*.pem
*.p12
*.jks
*.keystore
key.properties

# Database exports & dump files
db_*.json
*.dump
*.sql

# ---------------------------------------------------------------------
# 4. Flutter & Dart (Build & Cache)
# ---------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/
**/doc/api/
.widget_preview/
app.*.symbols
app.*.map.json

# ---------------------------------------------------------------------
# 5. Android & Gradle (Build Outputs & Studio Cache)
# ---------------------------------------------------------------------
.gradle/
android/.gradle/
/android/build/
android/app/build/
android/local.properties
android/captures/
.cxx/
android/.cxx/
android/app/.cxx/
android/gradle_*.txt
gradle_*.txt

# Build Artifacts
/android/app/debug/
/android/app/profile/
/android/app/release/
*.apk
*.ap_
*.aab
*.dex

# ---------------------------------------------------------------------
# 6. IDEs & Editors (VS Code, IntelliJ, Android Studio)
# ---------------------------------------------------------------------
# VS Code
.vscode/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# ---------------------------------------------------------------------
# 7. Miscellaneous & Temporary Files
# ---------------------------------------------------------------------
*.class
*.log
*.pyc
*.swp
*.tmp
*.bak
*.temp
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
